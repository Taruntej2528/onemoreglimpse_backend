# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/prazna_photography

# Active Storage Provider: 'local' | 'cloudinary' | 's3' | 'azure' | 'gcs' | 'firebase'
# (Note: The admin panel can also switch this dynamically via Settings API)
ACTIVE_STORAGE_PROVIDER=cloudinary

# 1. AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=prazna-photography-bucket
AWS_CUSTOM_DOMAIN=

# 2. Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string
AZURE_STORAGE_CONTAINER_NAME=prazna-media
AZURE_STORAGE_ACCOUNT_NAME=praznastorage
AZURE_STORAGE_ACCOUNT_KEY=your_azure_account_key
AZURE_CUSTOM_DOMAIN=

# 3. Google Cloud Storage (GCS) Configuration
GCS_PROJECT_ID=prazna-photography-prod
GCS_CLIENT_EMAIL=service-account@prazna-photography-prod.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
GCS_BUCKET_NAME=prazna-photography-media
GCS_CUSTOM_DOMAIN=

# 4. Firebase Storage Configuration
FIREBASE_PROJECT_ID=prazna-photography
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@prazna-photography.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=prazna-photography.appspot.com

# 5. Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=dbwzgdmtv
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=prazna-photography

# 6. Local Storage Configuration (for offline development)
LOCAL_UPLOAD_DIR=uploads
LOCAL_BASE_URL=http://localhost:5000/uploads
